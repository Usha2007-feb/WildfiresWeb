  text-shadow:
    -2px -2px 0 rgba(255,255,255,0.97),
     2px -2px 0 rgba(255,255,255,0.97),
    -2px  2px 0 rgba(255,255,255,0.97),
     2px  2px 0 rgba(255,255,255,0.97),
     0px  4px 10px rgba(0,40,20,0.50),
     0px  1px  3px rgba(0,0,0,0.40);
